```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js
*.ts
*.tsx

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Temporary files
*.tmp
*.swp

# IDE specific
.vscode/
.idea/

# Python related (if any Python in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Coverage reports
coverage/
htmlcov/
.coverage

# Testing
.mypy_cache/
.pytest_cache/

# OS generated
.DS_Store
Thumbs.db
```